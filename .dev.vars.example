# Cloudflare Workers local development secrets
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and should never be committed

# Google OAuth2 for Gmail API (run: bun run scripts/setup-gmail-oauth.ts)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token

# Telegram Bot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# DeepSeek AI
# DEEPSEEK_API_KEY=sk-...
